{
  "permissions": {
    "deny": [
      "Edit(/lib/**)",
      "Write(/lib/**)",
      "Edit(/foundry.lock)",
      "Write(/foundry.lock)",
      "Read(/.env)",
      "Read(/.env.sepolia)",
      "Read(/.env.mainnet)",
      "Read(/.env.local)",
      "Bash(git tag *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git merge *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git clone *)",
      "Bash(git submodule update *)",
      "Bash(git submodule add *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune *)",
      "Bash(forge install *)",
      "Bash(forge update *)",
      "Bash(forge remove *)",
      "Bash(foundryup *)",
      "Bash(foundryup)",
      "Bash(sudo *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(npm install *)",
      "Bash(brew install *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:github.com)",
      "CronCreate",
      "ScheduleWakeup",
      "RemoteTrigger",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task",
      "mcp__scheduled-tasks__run_scheduled_task",
      "mcp__ccd_session_mgmt__send_message"
    ],
    "ask": [
      "Bash(forge script *)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git check-ignore *)",
      "Bash(git rev-parse *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git worktree list)",
      "Bash(git -C /Users/janus/code/aumm-deploy status *)",
      "Bash(git -C /Users/janus/code/aumm-deploy log *)",
      "Bash(git -C /Users/janus/code/aumm-deploy diff *)",
      "Bash(git -C /Users/janus/code/aumm-deploy show *)",
      "Bash(git -C /Users/janus/code/aumm-deploy rev-parse *)",
      "Bash(git -C /Users/janus/code/aumm-deploy add *)",
      "Bash(git -C /Users/janus/code/aumm-deploy commit --only *)",
      "Bash(GIT_TERMINAL_PROMPT=0 git -C /Users/janus/code/aumm-deploy push)",
      "Bash(git -C /Users/janus/code/aumm-site pull --ff-only)",
      "Bash(GIT_TERMINAL_PROMPT=0 git -C /Users/janus/code/aumm-site pull --ff-only)",
      "Bash(cp .env.mainnet .env)",
      "Bash(cp .env.sepolia .env)",
      "Bash(cmp *)",
      "Bash(python3 -I -S tools/*)",
      "Bash(wc *)",
      "Bash(shasum *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(stat *)",
      "Bash(od *)",
      "Bash(file *)",
      "Bash(nl *)",
      "Bash(cut *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(tr *)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(test *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(jq *)",
      "Bash(bash -n *)",
      "Bash(forge build)",
      "Bash(forge build *)",
      "Bash(forge test *)",
      "Bash(forge lint)",
      "Bash(forge lint *)",
      "Bash(forge fmt --check *)",
      "Bash(forge clean)",
      "Bash(forge config)",
      "Bash(forge config *)",
      "Bash(forge tree *)",
      "Bash(forge remappings *)",
      "Bash(forge inspect *)",
      "Bash(.venv/bin/slither *)",
      "Bash(slither *)",
      "Bash(hevm *)",
      "Bash(cast *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-go-ahead.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-write.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "ScheduleWakeup|CronCreate|RemoteTrigger|SendMessage|Workflow|Agent|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-injection.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-write.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-terminal.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
