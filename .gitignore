# Foundry
out/
# PB-D34 vault compiler profile output; required by DeployAureumVault. Regenerate: FOUNDRY_PROFILE=vault forge build
out-vault/
cache/
broadcast/
artifacts/

# Dependencies (managed via submodule and forge install)
# Note: lib/ itself is NOT ignored because the submodule pointer must be tracked.
# Individual lib/ contents are managed by git submodules.

# Environment
# .env.* covers every chain overlay and any hand-made backup, since PB-D36's
# copy-and-refresh model makes stray copies easy to produce; the committed
# template is the sole exception and must stay visible.
.env
.env.*
!.env.example

# Python venv (for slither, added in Stage B)
.venv/
venv/
__pycache__/
*.pyc

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# Cursor
.cursor/
.cursor-server/

# Logs and temp
*.log
*.tmp
tmp/

# OS temp files
Thumbs.db
desktop.ini
.claude/
